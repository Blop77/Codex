{
  "name": "hivemind-twitch",
  "version": "1.0.0",
  "private": true,
  "description": "Twitch chat Hivemind server and overlay",
  "scripts": {
    "dev": "node --require ./sim/tsx-bootstrap.cjs ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "sim": "node --require ./sim/tsx-bootstrap.cjs ./node_modules/tsx/dist/cli.mjs sim/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^7.47.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
